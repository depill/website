{
  "name": "depill-is",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "deploy:check": "npm run check && npm run build && wrangler deploy --dry-run",
    "new": "node scripts/new.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.9.3",
    "wrangler": "4.132.0"
  }
}
