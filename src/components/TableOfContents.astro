---
import type { MarkdownHeading } from "astro";
interface Props {
  headings: MarkdownHeading[];
  label?: string;
}
const headings = Astro.props.headings.filter(
  (h) => h.depth === 2 || h.depth === 3,
);
---

{headings.length > 1 && (
  <details class="toc">
    <summary>{Astro.props.label ?? "On this page"}</summary>
    <ul>
      {headings.map((h) => (
        <li class:list={{ subheading: h.depth === 3 }}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </details>
)}
