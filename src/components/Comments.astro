---
import { comments } from "../site";
const enabled = Object.values(comments).every(Boolean);
---

{enabled && (
  <section class="comments" aria-labelledby="comments-heading">
    <h2 id="comments-heading">Conversation</h2>
    <p>
      Questions or a different approach? Join the discussion with your GitHub
      account.
    </p>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={comments.repo}
      data-repo-id={comments.repoId}
      data-category={comments.category}
      data-category-id={comments.categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
    <noscript>
      <p>
        Enable JavaScript to see comments, or{" "}
        <a href={`https://github.com/${comments.repo}/discussions`}>
          visit the discussions on GitHub
        </a>
        .
      </p>
    </noscript>
  </section>
)}
