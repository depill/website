---
import type { CollectionEntry } from "astro:content";
import { entryUrl, formatDate, readingTime } from "../lib/content";
interface Props {
  entries: CollectionEntry<"writing">[];
}
const { entries } = Astro.props;
---

<div class="entry-list">
  {entries.map((entry) => (
    <article class="entry-row">
      <div class="entry-meta">
        <time datetime={entry.data.date.toISOString()}>
          {formatDate(entry.data.date)}
        </time>
        <span>{entry.data.kind === "article" ? "Article" : "Field note"}</span>
      </div>
      <div class="entry-summary">
        <h3>
          <a href={entryUrl(entry)}>
            {entry.data.title}
            <span aria-hidden="true"> ↗</span>
          </a>
        </h3>
        <p>{entry.data.description}</p>
        <div class="tags">
          {entry.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
          <span class="read-time">{readingTime(entry.body)} min read</span>
        </div>
      </div>
    </article>
  ))}
</div>
