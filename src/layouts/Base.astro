---
import "../styles/global.css";
import { site } from "../site";
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
  lang?: "en" | "is";
}
const {
  title,
  description = site.description,
  article = false,
  noindex = false,
  lang = "en",
} = Astro.props;
const pageTitle = title ? `${title} · depill` : "depill · Notes from the work";
const path = Astro.url.pathname;
const is = lang === "is";
const nav = [
  { href: "/pos/", label: "POS", icon: "sales" },
  { href: "/writing/", label: is ? "Greinar" : "Writing", icon: "edit" },
  {
    href: "/docs/",
    label: is ? "Leiðbeiningar" : "Documentation",
    icon: "notes",
  },
  { href: "/about/", label: is ? "Um depill" : "About", icon: "info" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="publisher" content={site.company} />
    <meta name="theme-color" content="#78EBC2" />
    <link rel="canonical" href={new URL(path, site.url)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="depill — Writing"
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={new URL(path, site.url)} />
    <meta property="og:site_name" content="depill" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {is ? "Fara í efni" : "Skip to content"}
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a
          class="wordmark"
          href="/"
          aria-label={is ? "depill forsíða" : "depill home"}
        >
          <img
            class="brand-icon"
            src="/icons/brand/supergut-app-mint-rounded.svg"
            width="44"
            height="44"
            alt=""
          />
          <span class="wordmark-text">
            depill<span aria-hidden="true">.</span>
          </span>
        </a>
        <nav aria-label={is ? "Aðalvalmynd" : "Main navigation"}>
          {nav.map(({ href, label, icon }) => (
            <a
              href={href}
              aria-current={path.startsWith(href) ? "page" : undefined}
            >
              <img
                class="ui-icon"
                src={`/icons/ui/${icon}.svg`}
                width="20"
                height="20"
                alt=""
              />
              {label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <a class="footer-brand" href="/">
            depill.
          </a>
          <p>
            {is
              ? `depill.is er rekið af ${site.company}.`
              : `depill.is is operated by ${site.company}.`}
          </p>
        </div>
        <div class="footer-details">
          <span>
            {site.company} · kt. {site.registration}
          </span>
          <a href={`/pos/privacy/${lang}/`}>
            {is ? "Persónuvernd POS" : "POS privacy"}
          </a>
          <a href={`/pos/support/${lang}/`}>
            {is ? "Aðstoð við POS" : "POS support"}
          </a>
          <a href="/rss.xml">
            {is ? "RSS-straumur" : "RSS feed"} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
