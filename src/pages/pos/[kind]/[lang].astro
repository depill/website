---
import Base from "../../../layouts/Base.astro";

export function getStaticPaths() {
  return ["privacy", "support"].flatMap((kind) =>
    ["en", "is"].map((lang) => ({ params: { kind, lang } })),
  );
}
const is = Astro.params.lang === "is";
const privacy = Astro.params.kind === "privacy";
const lang = is ? "is" : "en";
const title = privacy
  ? is
    ? "Persónuverndarstefna — Supergut POS"
    : "Privacy notice — Supergut POS"
  : is
    ? "Aðstoð við Supergut POS"
    : "Supergut POS support";
const description = privacy
  ? is
    ? "Upplýsingar um vinnslu persónuupplýsinga, varðveislu og réttindi í Supergut POS."
    : "How Supergut POS handles personal information, retention and your privacy rights."
  : is
    ? "Hafðu samband við Supergut vegna uppsetningar, sölu, endurgreiðslna og kvittana."
    : "Contact Supergut for help with setup, sales, refunds and receipts.";
---

