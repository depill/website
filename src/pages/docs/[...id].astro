---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { publishedDocs, entryUrl, formatDate } from "../../lib/content";
export async function getStaticPaths() {
  return (await publishedDocs()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const docs = await publishedDocs();
const sections = [...new Set(docs.map((doc) => doc.data.section))];
const { Content, headings } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} article>
  <div class="docs-layout">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a href="/docs/">← Documentation</a>
      {sections.map((section) => (
        <section>
          <h2>{section}</h2>
          <ul>
            {docs
              .filter((doc) => doc.data.section === section)
              .map((doc) => (
                <li>
                  <a
                    href={entryUrl(doc)}
                    aria-current={doc.id === entry.id ? "page" : undefined}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </aside>
    <article class="article">
      <header class="article-header">
        <span class="eyebrow">{entry.data.section}</span>
        <h1>{entry.data.title}</h1>
        <p class="article-deck">{entry.data.description}</p>
        <div class="article-meta">
          <span>
            Updated{" "}
            <time
              datetime={(entry.data.updated ?? entry.data.date).toISOString()}
            >
              {formatDate(entry.data.updated ?? entry.data.date)}
            </time>
          </span>
        </div>
      </header>
      <TableOfContents headings={headings} />
      <div class="prose">
        <Content />
      </div>
      {entry.data.comments && <Comments />}
    </article>
  </div>
</Base>
