---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { publishedDocs, entryUrl, formatDate } from "../../lib/content";
export async function getStaticPaths() {
  return (await publishedDocs()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const is = entry.data.lang === "is";
const docs = await publishedDocs();
const sections = [...new Set(docs.map((doc) => doc.data.section))];
const { Content, headings } = await render(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  article
>
  <div class="docs-layout">
    <aside
      class="docs-sidebar"
      aria-label={is ? "Leiðbeiningar" : "Documentation navigation"}
    >
      <a href="/docs/">← {is ? "Allar leiðbeiningar" : "Documentation"}</a>
      {is && (
        <p>
          <a href="/pos/">← Supergut POS</a>
        </p>
      )}
      {sections.map((section) => (
        <section>
          <h2>{section}</h2>
          <ul>
            {docs
              .filter((doc) => doc.data.section === section)
              .map((doc) => (
                <li>
                  <a
                    href={entryUrl(doc)}
                    aria-current={doc.id === entry.id ? "page" : undefined}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </aside>
    <article class="article">
      <header class="article-header">
        <span class="eyebrow">{entry.data.section}</span>
        <h1>{entry.data.title}</h1>
        <p class="article-deck">{entry.data.description}</p>
        <div class="article-meta">
          <span>
            {is ? "Uppfært" : "Updated"}{" "}
            <time
              datetime={(entry.data.updated ?? entry.data.date).toISOString()}
            >
              {formatDate(
                entry.data.updated ?? entry.data.date,
                entry.data.lang,
              )}
            </time>
          </span>
        </div>
      </header>
      <TableOfContents
        headings={headings}
        label={is ? "Á þessari síðu" : "On this page"}
      />
      <div class="prose">
        <Content />
      </div>
      {entry.data.comments && <Comments />}
    </article>
  </div>
</Base>
