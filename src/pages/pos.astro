---
import Base from "../layouts/Base.astro";
import { publishedDocs, entryUrl } from "../lib/content";
const guides = (await publishedDocs()).filter((doc) =>
  doc.id.startsWith("pos/"),
);
const features = [
  {
    icon: "sales",
    title: "Afgreiðsla á iPad",
    text: "Sérsmíðað iPad-forrit fyrir vöruleit, strikamerki, körfu og greiðslur. Starfsmaður tengir tækið við verslun með QR-kóða.",
  },
  {
    icon: "sync",
    title: "Tenging við Business Central",
    text: "Vörur, verð og viðskiptavinir berast í afgreiðslukerfið. Söluupplýsingar fara til baka í bókunarferli með sýnilegri stöðu.",
  },
  {
    icon: "products",
    title: "Umsjón á einum stað",
    text: "Stjórnborð fyrir verslanir, afgreiðslukassa, starfsfólk og vörugögn. Þar má einnig fylgjast með samstillingu og afhendingu til bókhalds.",
  },
];
---

<Base
  lang="is"
  title="Supergut POS — iPad og Business Central"
  description="Supergut POS er ókeypis afgreiðslulausn í þróun fyrir iPad með tengingu við Microsoft Dynamics 365 Business Central. Kynning og leiðbeiningar á íslensku."
>
  <section class="pos-intro">
    <div>
      <span class="eyebrow">Supergut POS · Ókeypis · Í þróun</span>
      <h1>
        Afgreiðslan á iPad.
        <br />
        Tengingin við reksturinn<span class="accent">.</span>
      </h1>
      <p class="pos-deck">
        Frá vöruvali í verslun að sölu í Business Central. Við erum að þróa
        ókeypis afgreiðslulausn sem tengir dagleg störf við vörugögn, greiðslur
        og bókhald.
      </p>
      <a class="text-link" href="/docs/pos/fyrstu-skref/">
        Kynnast iPad-forritinu <span aria-hidden="true">↗</span>
      </a>
      <p class="pos-caption">
        Verkefni frá Supergut ehf, fyrirtækinu á bak við depill.is.
      </p>
    </div>
    <figure class="pos-preview">
      <img
        src="/images/pos/ipad-demo.png"
        width="1312"
        height="1902"
        alt="Prufuverslun í Supergut POS á iPad með vöruspjöldum, vöruleit og hnöppum fyrir skönnun og körfu."
      />
      <figcaption>
        Prufuútgáfa á iPad-hermi. Sýnigögn og enskur viðmótstexti; engar
        raunverulegar greiðslur.
      </figcaption>
    </figure>
  </section>
  <section class="pos-features" aria-label="Helstu hlutar lausnarinnar">
    {features.map(({ icon, title, text }) => (
      <article>
        <img src={`/icons/ui/${icon}.svg`} width="28" height="28" alt="" />
        <h2>{title}</h2>
        <p>{text}</p>
      </article>
    ))}
  </section>
  <section class="notebook-section" aria-labelledby="pos-free">
    <div>
      <span class="eyebrow">Af hverju ókeypis?</span>
      <h2 id="pos-free">Gert fyrir eigin þörf. Opið öðrum.</h2>
      <p>
        Supergut POS er ókeypis. Ég þróa lausnina fyrir fyrirtæki sem tengist
        mér og vil leyfa öðrum að nýta hana líka. Hún er unnin með aðstoð
        gervigreindar, sem hjálpar mér að koma hugmyndum í framkvæmd og þróa
        verkefnið áfram.
      </p>
    </div>
    <div>
      <span class="eyebrow">Greiðslutengingar</span>
      <h2>Teya og Netgíró.</h2>
      <p>
        Eins og staðan er í dag eru eingöngu tengingar við Teya og Netgíró
        studdar. Aðrar greiðslukortatengingar eru ekki á áætlun og verða að
        öllum líkindum ekki í boði. Stuðningur við Teya Raðgreiðslur er
        væntanlegur á næstunni.
      </p>
    </div>
  </section>
  <section class="notebook-section" aria-labelledby="pos-flow">
    <div>
      <span class="eyebrow">Frá afgreiðslu til bókhalds</span>
      <h2 id="pos-flow">Sama sala. Skýr staða.</h2>
      <p>
        Afgreiðsla og bókun eru tvö skref. Starfsmaður þarf að geta séð hvort
        sala sé lokið og hvort hún hafi einnig verið bókuð í Business Central.
      </p>
      <a class="text-link" href="/docs/pos/business-central/">
        Skoða tenginguna <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ol class="pos-flow">
      <li>
        <strong>Vörur og verð</strong>
        <span>Gögn úr Business Central eru samstillt við POS.</span>
      </li>
      <li>
        <strong>Karfa og greiðsla</strong>
        <span>Afgreiðslumaður velur vörur og lýkur sölu.</span>
      </li>
      <li>
        <strong>Afhending og bókun</strong>
        <span>Salan fer í biðröð og bókunarstaða er sótt til baka.</span>
      </li>
    </ol>
  </section>
  <section class="pos-guides" aria-labelledby="pos-guides">
    <div class="section-heading">
      <h2 id="pos-guides">Leiðbeiningar á íslensku</h2>
      <span class="eyebrow">Byrjum hér</span>
    </div>
    {guides.map((guide) => (
      <article class="doc-index-item">
        <a href={entryUrl(guide)}>
          {guide.data.title} <span aria-hidden="true">↗</span>
        </a>
        <p>{guide.data.description}</p>
      </article>
    ))}
  </section>
  <aside class="pos-status">
    <h2>Hvar stendur verkefnið?</h2>
    <p>
      iPad-forrit, prufuverslun, stjórnborð og BC-tenging eru komin í
      þróunarútgáfu. Bókun í BC-prófunarumhverfi, greiðslubúnaður og notkun á
      raunverulegum iPad þurfa frekari staðfestingu áður en lausnin fer í
      daglegan rekstur.
    </p>
    <a href="/docs/pos/greidslur-og-stada/">
      Lesa um greiðslur og stöðu þróunar →
    </a>
  </aside>
</Base>
<style>
  .pos-intro {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 56px;
    align-items: center;
    padding: 60px 0;
  }
  .pos-intro h1 {
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    margin: 20px 0 24px;
  }
  .pos-deck {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 650px;
  }
  .pos-caption,
  figcaption {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 16px;
  }
  .pos-preview {
    margin: 0;
  }
  .pos-preview img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 470px;
    object-fit: contain;
    border-radius: 20px;
    background: var(--white);
    border: 1px solid var(--border);
  }
  .pos-features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .pos-features article {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px;
  }
  .pos-features h2 {
    font-size: 1.2rem;
    margin: 18px 0 12px;
  }
  .pos-features p,
  .pos-flow span {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .pos-flow {
    margin: 0;
    padding-left: 24px;
  }
  .pos-flow li {
    padding: 8px 0 14px 8px;
  }
  .pos-flow li::marker {
    color: var(--purple);
    font-weight: 700;
  }
  .pos-flow strong,
  .pos-flow span {
    display: block;
  }
  .pos-guides {
    margin-top: 52px;
  }
  .pos-status {
    padding: 28px;
    margin-top: 40px;
    border-left: 4px solid var(--mint);
    background: var(--white);
    border-radius: 0 16px 16px 0;
  }
  .pos-status h2 {
    font-size: 1.3rem;
  }
  .pos-status p {
    margin: 14px 0;
    color: var(--text-secondary);
  }
  .pos-status a {
    color: var(--purple);
  }
  @media (max-width: 800px) {
    .pos-intro {
      gap: 28px;
    }
    .pos-features {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pos-intro {
      grid-template-columns: 1fr;
      padding: 36px 0;
    }
    .pos-preview img {
      max-height: 400px;
    }
    .pos-status {
      padding: 22px;
    }
  }
</style>
