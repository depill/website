---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { publishedWriting, formatDate, readingTime } from "../../lib/content";
import { site } from "../../site";
export async function getStaticPaths() {
  return (await publishedWriting()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"writing">;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} article>
  <article class="article">
    <a href="/writing/" class="back-link">
      ← All writing
    </a>
    <header class="article-header">
      <span class="eyebrow">
        {entry.data.kind === "article" ? "Article" : "Field note"}
      </span>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <div class="article-meta">
        <span>{site.author}</span>
        <time datetime={entry.data.date.toISOString()}>
          {formatDate(entry.data.date)}
        </time>
        <span>{readingTime(entry.body)} min read</span>
        {entry.data.updated && (
          <span>Updated {formatDate(entry.data.updated)}</span>
        )}
      </div>
    </header>
    <TableOfContents headings={headings} />
    <div class="prose">
      <Content />
    </div>
    {entry.data.comments && <Comments />}
  </article>
</Base>
